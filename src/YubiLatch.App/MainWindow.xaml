<Window x:Class="YubiLatch.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YubiLatch.App"
    Title="YubiLatch">
    <Grid x:Name="Root">
        <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            SelectionChanged="NavigationChanged" OpenPaneLength="220" CompactPaneLength="52" AlwaysShowHeader="False">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,28,0,28">
                    <Border Background="#1B5C54" CornerRadius="9" Width="36" Height="36">
                        <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YubiLatch" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="本地硬件认证" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="overview" Icon="Home" IsSelected="True"/>
                <NavigationViewItem Content="安全钥匙" Tag="keys"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="登录设置" Tag="settings" Icon="Setting"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="恢复与帮助" Tag="recovery" Icon="Help"/>
            </NavigationView.FooterMenuItems>
            <NavigationView.PaneFooter><TextBlock Text="0.1.0 · 预发布" FontSize="12" Margin="28,16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></NavigationView.PaneFooter>
            <ScrollViewer>
                <StackPanel x:Name="PageContent" MaxWidth="1040" HorizontalAlignment="Stretch" Margin="36,36,36,48" Spacing="24">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="PageTitle" Text="把钥匙，带在身边。" FontSize="30" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSubtitle" Text="通过 YubiKey 的物理触摸，连接到你的 Windows。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新状态" Click="RefreshClick" VerticalAlignment="Top"/>
                    </Grid>
                    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="正在读取状态"/>

                    <StackPanel x:Name="OverviewPage" Spacing="20">
                        <Border Style="{StaticResource CardStyle}" Padding="28">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                <StackPanel Spacing="14" VerticalAlignment="Center">
                                    <TextBlock Text="你的 Windows，你的钥匙" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock x:Name="Readiness" Text="尚未连接" FontSize="26" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ReadinessDetail" Text="先连接本地服务，再绑定你的第一把安全钥匙。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <Button Content="绑定安全钥匙" Style="{StaticResource AccentButtonStyle}" Click="EnrollClick" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="116" Height="164" CornerRadius="22" Background="#1B5C54" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                                        <FontIcon Glyph="&#xE72E;" FontSize="38" Foreground="#DDECD2"/>
                                        <Ellipse Width="34" Height="34" Stroke="#DDECD2" StrokeThickness="3"/>
                                        <TextBlock Text="TOUCH" Foreground="#DDECD2" FontSize="10" CharacterSpacing="180" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="已验证的钥匙" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="KeyCount" Text="—" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="BackupState" Text="尚未读取状态" FontSize="12"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel Spacing="10"><TextBlock Text="Windows 登录组件" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ProviderState" Text="—" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="安装、绑定、启用分步进行；系统原有登录方式始终保留。" FontSize="12"/></StackPanel></Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="从这里开始" Style="{StaticResource SectionTitle}"/><TextBlock Text="1　确认你的密码、PIN 或 Windows Hello 能独立登录。"/><TextBlock Text="2　插入 USB YubiKey，为空闲的槽位 2 创建绑定。"/><TextBlock Text="3　建议绑定备用钥匙，再按说明单独启用登录组件。"/><TextBlock Text="日常使用：选择 YubiLatch 登录方式 → 插入钥匙 → 灯闪烁时触摸。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="KeysPage" Visibility="Collapsed" Spacing="20">
                        <Grid><Button Content="绑定另一把钥匙" Style="{StaticResource AccentButtonStyle}" Click="EnrollClick"/><Button Content="刷新设备" Click="DevicesClick" HorizontalAlignment="Right"/></Grid>
                        <TextBlock x:Name="DevicesText" Text="点击刷新设备以检测 USB YubiKey。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ListView x:Name="KeysList" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:KeyItem">
                                    <Grid Padding="12,18" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8D7;" FontSize="24" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                        <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="恢复验证" Visibility="{x:Bind PendingVisibility}" Tag="{x:Bind Id}" Click="ResumeClick"/><Button Content="管理码" Tag="{x:Bind Id}" Click="ManagementCodeClick"/><Button Content="撤销" Tag="{x:Bind Id}" Click="RemoveClick"/></StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="撤销仅移除本机绑定，不擦除钥匙槽位。待验证绑定可恢复验证；若槽位尚未写入，可撤销记录后重新绑定。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="20">
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><TextBlock Text="钥匙登录" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="EnabledText" Text="尚未读取状态"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="启用此账户" Tag="enable" Click="EnableClick"/><Button Content="暂停此账户" Tag="pause" Click="EnableClick"/></StackPanel><TextBlock Text="暂停后使用 Windows 原有登录方式；恢复启用需要再次验证账户密码。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="16"><TextBlock Text="账户凭据" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="AccountText" Text="尚未绑定 Microsoft 账户"/><TextBlock Text="更改 Microsoft 账户密码后，请在这里更新。PIN 和 Windows Hello 数据不会被读取或保存。"/><Button Content="更新已保存的密码" Click="UpdatePasswordClick"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="认证策略" Style="{StaticResource SectionTitle}"/><TextBlock Text="每次认证强制触摸 · 独立随机挑战 · 本地验证"/><TextBlock Text="为保护现有配置，只允许使用空闲 OTP 长按槽位 2。触摸要求不能在此关闭。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
                    </StackPanel>

                    <StackPanel x:Name="RecoveryPage" Visibility="Collapsed" Spacing="20">
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Windows 原有登录方式始终保留" Message="钥匙遗失或服务不可用时，在登录屏幕选择“登录选项”，使用 PIN、密码或 Windows Hello。"/>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="钥匙不在身边" Style="{StaticResource SectionTitle}"/><TextBlock Text="使用备用钥匙，或先通过 Windows 原有方式登录，再到“安全钥匙”撤销遗失钥匙。新钥匙需要单独绑定。"/><TextBlock Text="不创建可绕过账户密码的恢复码。系统恢复方式是最终的恢复入口。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="服务或登录组件异常" Style="{StaticResource SectionTitle}"/><TextBlock Text="切换到系统登录方式。进入桌面后，用安装包的 Disable-Provider.ps1 紧急停用组件；如无法进入桌面，按 recovery.md 的 WinRE 离线步骤处理。"/><Button Content="打开本地恢复文档" Click="OpenRecoveryClick"/></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="14"><TextBlock Text="删除本机绑定" Style="{StaticResource SectionTitle}"/><TextBlock Text="删除当前账户的全部加密凭据与钥匙记录。Windows 账户、Passkey、OpenPGP 和硬件槽位保留。"/><Button Content="删除全部本机数据…" Click="ForgetClick"/></StackPanel></Border>
                        <TextBlock Text="此版本尚需在独立测试机完成真实登录验收。首次账户设置、无密码 MSA、BitLocker 预启动和远程桌面不在支持范围。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="LastChecked" Text="尚未读取状态" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
